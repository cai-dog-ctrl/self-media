# 云端语音解说（腾讯云 · 语音合成）配置模板
# 1. 复制本文件为 .env.local（已被 .gitignore 忽略，不会提交）
# 2. 注册腾讯云并完成个人认证（基础语音合成每月 100 万字符免费额度）
# 3. 控制台 → 访问管理 CAM → API 密钥管理，创建密钥获取 SecretId / SecretKey
#    （建议使用子账号密钥并只授权「语音合成」相关权限，最小化风险）
# 4. 控制台搜索「语音合成」开通服务
# 5. 重启 npm run dev 生效

# 腾讯云 API 密钥（两项都必填才启用云端解说）
TENCENT_TTS_SECRET_ID=
TENCENT_TTS_SECRET_KEY=

# 服务区域（默认 ap-shanghai，可选 ap-guangzhou / ap-beijing 等）
TENCENT_TTS_REGION=ap-shanghai
